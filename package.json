{
  "name": "solastio-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "powershell -ExecutionPolicy Bypass -File scripts/start-new-api.ps1",
    "api:release": "powershell -ExecutionPolicy Bypass -File scripts/start-new-api.ps1 -Release",
    "api:check": "cargo check --workspace --manifest-path \"NEW SOLASTIO APP/app/Cargo.toml\"",
    "api:test": "cargo test --workspace --manifest-path \"NEW SOLASTIO APP/app/Cargo.toml\"",
    "api:clippy": "cargo clippy --workspace --all-targets --manifest-path \"NEW SOLASTIO APP/app/Cargo.toml\" -- -D warnings",
    "app": "call \"C:\\Users\\Garv\\flutter\\bin\\flutter.bat\" run -d windows --dart-define=SOLASTIO_API_BASE=http://127.0.0.1:4000 --project-dir \"NEW SOLASTIO APP/flutter\"",
    "app:analyze": "call \"C:\\Users\\Garv\\flutter\\bin\\flutter.bat\" analyze \"NEW SOLASTIO APP/flutter\"",
    "app:test": "call \"C:\\Users\\Garv\\flutter\\bin\\flutter.bat\" test \"NEW SOLASTIO APP/flutter\"",
    "app:build:web": "call \"C:\\Users\\Garv\\flutter\\bin\\flutter.bat\" build web --dart-define=SOLASTIO_API_BASE=http://127.0.0.1:4000 --project-dir \"NEW SOLASTIO APP/flutter\"",
    "app:build:windows": "call \"C:\\Users\\Garv\\flutter\\bin\\flutter.bat\" build windows --dart-define=SOLASTIO_API_BASE=http://127.0.0.1:4000 --project-dir \"NEW SOLASTIO APP/flutter\"",
    "app:build:apk": "set GRADLE_USER_HOME=C:\\Users\\Garv\\AppData\\Local\\Temp\\opencode\\gradle-solastio&& call \"C:\\Users\\Garv\\flutter\\bin\\flutter.bat\" build apk --dart-define=SOLASTIO_API_BASE=http://127.0.0.1:4000 --project-dir \"NEW SOLASTIO APP/flutter\"",
    "build": "npm run app:build:web",
    "test": "npm run app:test && npm run api:test"
  }
}
