{
  "name": "aura-staff-server",
  "version": "0.1.0",
  "private": true,
  "description": "Independent multi-tenant backend for the Aura Staff App (appointments, staff, WhatsApp booking automation).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:memory": "tsx src/dev-memory.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "seed": "tsx src/seed.ts",
    "prod:check": "tsx src/ops/production-check.ts",
    "db:indexes": "tsx src/ops/sync-indexes.ts",
    "cleanup": "tsx src/jobs/cleanup.ts",
    "reminders": "tsx src/jobs/appointment-reminders.ts",
    "whatsapp:retry": "tsx src/jobs/whatsapp-retry.ts",
    "shopify:automation": "tsx src/jobs/shopify-automation.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  }
}
