# Copy to /etc/salonflow/salonflow.env on the Oracle VM and fill values there.
# Never commit the filled env file.

NODE_ENV=production
PORT=4000

MONGODB_URI=
MONGODB_MAX_POOL_SIZE=10
MONGODB_AUTO_INDEX=false

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

CORS_ORIGINS=https://staff-app-kappa.vercel.app,https://browser-lilac-one.vercel.app
COOKIE_SECURE=true
COOKIE_SAMESITE=none

SEED_SALON_ID=tenant_aura
SEED_SALON_NAME=Aura Shine Salon & Wellness
SALON_TIMEZONE=Asia/Kolkata
SEED_OWNER_LOGIN=owner
SEED_OWNER_PASSWORD=
SEED_STAFF_LOGIN=reception
SEED_STAFF_PASSWORD=

WHATSAPP_PROVIDER=
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v21.0
META_API_VERSION=v21.0
META_APP_ID=
META_CONFIG_ID=
META_APP_SECRET=
META_WEBHOOK_APP_SECRET=
META_CREDENTIAL_ENCRYPTION_KEY=
VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_WABA_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_customers,read_orders,read_products,read_checkouts,write_webhooks
SHOPIFY_APP_URL=
SHOPIFY_JWT_SECRET=
SHOPIFY_ADMIN_EMAIL=
SHOPIFY_ADMIN_PASSWORD=
SHOPIFY_CLIENT_EMAIL=
SHOPIFY_CLIENT_PASSWORD=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
